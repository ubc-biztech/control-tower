# Tower P0 is fully mocked and makes ZERO network calls.
# These are the vars the real v0 server will need. None are read yet.
#
# AWS_ACCESS_KEY_ID=            # serverless-biztechapp CI IAM user, READ-ONLY
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2
# GITHUB_TOKEN=                 # workflow_dispatch on rollback.yml only
# GITHUB_REPO=ubc-biztech/serverless-biztechapp
# TOWER_PASSWORD=

# P0 toggle: "mock" is the only supported value today.
VITE_TOWER_DATA_SOURCE=mock

# --- auth (v1) -------------------------------------------------------
# Google OAuth client, restricted to the ubcbiztech.com Workspace domain.
# Create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must exactly match GOOGLE_REDIRECT_URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5273/api/auth/callback

# Signs the session cookie. Any long random string; rotating it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOWER_SESSION_SECRET=

# Local development only: sign in as this address without Google.
# Ignored when NODE_ENV=production. The address must still pass access.json.
# TOWER_DEV_LOGIN_EMAIL=dev@ubcbiztech.com
